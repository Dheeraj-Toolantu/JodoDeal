# Leave these blank to run in zero-config DEMO MODE (data stored in your browser).
# Fill them from Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Set to "true" to connect to the local Firebase Emulator Suite (npm run emulators).
VITE_USE_EMULATORS=false

# Force demo mode even when Firebase config is present.
VITE_DEMO_MODE=false
