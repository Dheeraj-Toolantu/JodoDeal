rules_version = '2';

// JodoDeal security rules.
// Clients only READ. Every state change goes through Cloud Functions (Admin SDK),
// which enforce business rules, idempotency and audit logging (BRD §12 Security, AC-13).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isStaff() { return signedIn() && me().role in ['admin', 'support', 'operations']; }
    function isOwner(data) { return signedIn() && data.uid == request.auth.uid; }
    function isMerchantOf(data) { return signedIn() && me().role == 'merchant' && me().merchantId == data.merchantId; }
    function canReadTxn(data) { return isOwner(data) || isMerchantOf(data) || isStaff(); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      // A user may create only their OWN profile, and only as a plain customer.
      // Roles, merchant links and status can only be changed by Cloud Functions / admins.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.merchantId == null
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.email == request.auth.token.get('email', null)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'phone', 'city', 'role', 'merchantId', 'status',
             'referralCode', 'addresses', 'notificationPrefs', 'interests', 'onboardedAt', 'createdAt']);
      // ...and edit only personal, non-privileged fields.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'phone', 'city', 'addresses', 'notificationPrefs', 'interests', 'onboardedAt']);
      allow delete: if false;
    }
    match /categories/{id} { allow read: if true; allow write: if false; }
    match /merchants/{id} { allow read: if true; allow write: if false; }
    match /merchantPrivate/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isStaff());
      allow write: if false;
    }
    match /offers/{id} {
      allow read: if resource.data.status in ['APPROVED', 'PAUSED'] || isMerchantOf(resource.data) || isStaff();
      allow write: if false;
    }
    match /groups/{id} {
      // Groups hold only counts, anonymous initials and terms — never member PII.
      allow read: if true;
      allow write: if false;
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isStaff());
        allow write: if false;
      }
    }
    match /reviews/{id} { allow read: if true; allow write: if false; }

    match /payments/{id} { allow read: if isOwner(resource.data) || isStaff(); allow write: if false; }
    match /orders/{id} { allow read: if canReadTxn(resource.data); allow write: if false; }
    match /bookings/{id} { allow read: if canReadTxn(resource.data); allow write: if false; }
    match /vouchers/{id} { allow read: if canReadTxn(resource.data); allow write: if false; }
    match /shipments/{id} { allow read: if canReadTxn(resource.data); allow write: if false; }
    match /refunds/{id} { allow read: if canReadTxn(resource.data); allow write: if false; }
    match /cases/{id} { allow read: if canReadTxn(resource.data); allow write: if false; }
    match /tickets/{id} { allow read: if isOwner(resource.data) || isStaff(); allow write: if false; }
    match /notifications/{id} { allow read: if isOwner(resource.data); allow write: if false; }

    match /auditLogs/{id} { allow read: if isStaff(); allow write: if false; }
    match /paymentEvents/{id} { allow read: if isStaff(); allow write: if false; }
    match /referrals/{id} { allow read: if isStaff(); allow write: if false; }
    match /meta/{id} { allow read: if isStaff(); allow write: if false; }
  }
}
